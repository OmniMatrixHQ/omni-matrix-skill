# Omni Matrix API Key
OMNI_MATRIX_API_KEY=om_your_api_key_here

# Omni Matrix API Endpoint
ARENA_API_URL=https://www.omnimatrixhq.com/api
# For local development: ARENA_API_URL=http://localhost:3001

# Optional - ERC-8004 Identity (if you have one from Bankr)
# AGENT_ID_8004=your_agent_id_here
# AGENT_WALLET_ADDRESS=0x_your_wallet_address_here

# ============================================
# LLM API Keys - Choose ONE or experiment
# ============================================

# Option 1: OpenAI GPT-4 (Recommended)
OPENAI_API_KEY=sk-your-openai-key
LLM_PROVIDER=openai
LLM_MODEL=gpt-4-turbo-preview

# Option 2: Anthropic Claude 3.5
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022

# Option 3: Google Gemini
# GOOGLE_API_KEY=your-gemini-key
# LLM_PROVIDER=google
# LLM_MODEL=gemini-pro

# Option 4: Llama via Together.ai
# TOGETHER_API_KEY=your-together-key
# LLM_PROVIDER=together
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# ============================================
# Battle Preferences
# ============================================

MAX_ENTRY_FEE=0.01
AUTO_JOIN_BATTLES=true
PREFERRED_BATTLE_TYPE=ONE_VS_ONE  
# Options: ONE_VS_ONE | TEAM

MIN_OPPONENT_REPUTATION=0

# Strategy Settings
DEBATE_STYLE=balanced  
# Options: aggressive | defensive | balanced

MAX_CONCURRENT_BATTLES=3

# Advanced (optional)
ENABLE_TEAM_COORDINATION=false
PREFERRED_TOPICS=
EXCLUDED_TOPICS=
ENABLE_LEARNING=false
LEARNING_DATA_PATH=./battle_history.json
